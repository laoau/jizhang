    /** 刷新折线图数据 */
    private void updateLineChart() {
        LineChart lineChart = binding.lineChart;
        Map<String, Double> dailyData = recordManager.getDailyExpense();

        if (dailyData.isEmpty()) {
            lineChart.setData(null);
            lineChart.invalidate();
            return;
        }

        ArrayList<Entry> entries = new ArrayList<>();
        ArrayList<String> labels = new ArrayList<>();
        int index = 0;
        for (Map.Entry<String, Double> entry : dailyData.entrySet()) {
            // 取日期中的日，如 "2026-05-15" → "15日"
            String day = entry.getKey();
            if (day.length() >= 10) {
                labels.add(day.substring(8) + "日"); // "2026-05-15" -> "15日"
            } else if (day.length() >= 8) {
                labels.add(day.substring(8)); // fallback
            } else {
                labels.add(day);
            }
            entries.add(new Entry(index, entry.getValue().floatValue()));
            index++;
        }

        LineDataSet dataSet = new LineDataSet(entries, "每日支出");
        dataSet.setColor(0xFF7C4DFF);
        dataSet.setLineWidth(2.5f);
        dataSet.setCircleColor(0xFF7C4DFF);
        dataSet.setCircleRadius(4f);
        dataSet.setDrawCircleHole(true);
        dataSet.setCircleHoleRadius(2f);
        dataSet.setValueTextSize(9f);
        dataSet.setValueTextColor(0xFF7C4DFF);
        dataSet.setDrawFilled(true);
        dataSet.setFillColor(0x337C4DFF);
        dataSet.setMode(LineDataSet.Mode.CUBIC_BEZIER);
        dataSet.setCubicIntensity(0.2f);

        LineData lineData = new LineData(dataSet);
        lineChart.setData(lineData);

        // 设置 X 轴标签
        XAxis xAxis = lineChart.getXAxis();
        xAxis.setValueFormatter(new IndexAxisValueFormatter(labels));
        xAxis.setLabelCount(Math.min(labels.size(), 10));

        lineChart.invalidate();
    }

    private int getColorForIndex(int index) {
        int[] c = {
            0xFFFF6F00, 0xFF7C4DFF, 0xFF00BCD4, 0xFF4CAF50,
            0xFFF44336, 0xFF9C27B0, 0xFFFF9800, 0xFF607D8B,
            0xFFE91E63, 0xFF3F51B5, 0xFF009688, 0xFF795548
        };
        return c[index % c.length];
    }

