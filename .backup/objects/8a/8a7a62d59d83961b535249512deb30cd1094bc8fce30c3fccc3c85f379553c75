    /** 当前图表模式：true=日，false=月 */
    private boolean isChartToday = true;

    private void setupPieChart() {
        PieChart pieChart = binding.pieChart;

        pieChart.setUsePercentValues(true);
        pieChart.getDescription().setEnabled(false);
        pieChart.setExtraOffsets(5, 10, 5, 5);
        pieChart.setDragDecelerationFrictionCoef(0.95f);
        pieChart.setCenterText("支出\n分类");
        pieChart.setCenterTextSize(12f);
        pieChart.setCenterTextColor(ContextCompat.getColor(this, R.color.text_primary));
        pieChart.setDrawHoleEnabled(true);
        pieChart.setHoleRadius(45f);
        pieChart.setTransparentCircleRadius(50f);
        // 开启动画
        pieChart.animateY(800);

        Legend l = pieChart.getLegend();
        l.setVerticalAlignment(Legend.LegendVerticalAlignment.TOP);
        l.setHorizontalAlignment(Legend.LegendHorizontalAlignment.RIGHT);
        l.setOrientation(Legend.LegendOrientation.VERTICAL);
        l.setDrawInside(false);
        l.setTextSize(10f);
        l.setXEntrySpace(4f);
        l.setYEntrySpace(2f);

        pieChart.setEntryLabelTextSize(10f);
        pieChart.setEntryLabelColor(ContextCompat.getColor(this, R.color.text_primary));
        pieChart.setDrawEntryLabels(true);

        // 日/月切换
        binding.btnTodayChart.setOnClickListener(v -> toggleChart(true));
        binding.btnMonthChart.setOnClickListener(v -> toggleChart(false));

        // 保存饼图按钮
        binding.btnSavePie.setOnClickListener(v -> saveChartToGallery(binding.pieChart, "支出分类"));
    }

    private void toggleChart(boolean isToday) {
        isChartToday = isToday;

        // 切换按钮样式
        if (isToday) {
            binding.btnTodayChart.setBackgroundResource(R.drawable.bg_toggle_active);
            binding.btnTodayChart.setTextColor(0xFFFFFFFF);
            binding.btnMonthChart.setBackgroundResource(android.R.color.transparent);
            binding.btnMonthChart.setTextColor(0xFF999999);
        } else {
            binding.btnMonthChart.setBackgroundResource(R.drawable.bg_toggle_active);
            binding.btnMonthChart.setTextColor(0xFFFFFFFF);
            binding.btnTodayChart.setBackgroundResource(android.R.color.transparent);
            binding.btnTodayChart.setTextColor(0xFF999999);
        }

        updatePieChart();
    }

    private void updatePieChart() {
        PieChart pieChart = binding.pieChart;

        // 根据日/月获取不同数据源
        Map<String, Double> data;
        if (isChartToday) {
            data = recordManager.getExpenseByCategoryFromList(recordManager.getTodayRecords());
        } else {
            data = recordManager.getExpenseByCategory();
        }

        ArrayList<PieEntry> entries = new ArrayList<>();
        for (Map.Entry<String, Double> entry : data.entrySet()) {
            if (entry.getValue() > 0) {
                entries.add(new PieEntry(entry.getValue().floatValue(), entry.getKey()));
            }
        }

        int[] colors = new int[entries.size()];
        for (int j = 0; j < entries.size(); j++) {
            colors[j] = getColorForIndex(j);
        }

        PieDataSet dataSet = new PieDataSet(entries, "");
        dataSet.setSliceSpace(2f);
        dataSet.setSelectionShift(4f);
        dataSet.setColors(colors);

        PieData pieData = new PieData(dataSet);
        pieData.setValueFormatter(new PercentFormatter(pieChart));
        pieData.setValueTextSize(10f);
        pieData.setValueTextColor(ContextCompat.getColor(this, R.color.text_primary));

        pieChart.setData(pieData);
        pieChart.highlightValues(null);
        pieChart.invalidate();
    }

