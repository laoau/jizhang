    /**
     * 弹出带倒计时的确认弹窗，5 秒倒计时结束后确认按钮才可用
     */
    private void showClearCountdown(int count) {
        // 自定义布局
        LinearLayout layout = new LinearLayout(this);
        layout.setOrientation(LinearLayout.VERTICAL);
        layout.setPadding(dp(24), dp(16), dp(24), dp(16));
        layout.setGravity(Gravity.CENTER);

        // 倒计时文字
        TextView countdownText = new TextView(this);
        countdownText.setGravity(Gravity.CENTER);
        countdownText.setTextSize(18);
        countdownText.setTextColor(ContextCompat.getColor(this, R.color.text_primary));
        countdownText.setText("5");
        countdownText.setPadding(0, dp(8), 0, dp(4));
        layout.addView(countdownText);

        // 提示文字
        TextView hintText = new TextView(this);
        hintText.setGravity(Gravity.CENTER);
        hintText.setTextSize(13);
        hintText.setTextColor(ContextCompat.getColor(this, R.color.text_secondary));
        hintText.setText("秒后可确认清空 " + count + " 条记录");
        hintText.setPadding(0, 0, 0, dp(8));
        layout.addView(hintText);

        AlertDialog.Builder builder = new AlertDialog.Builder(this);
        builder.setTitle("⚠️ 清空所有记录");
        builder.setView(layout);
        builder.setCancelable(false);

        // 先设置一个占位 PositiveButton，后面动态改状态
        AlertDialog dialog = builder.create();

        // 用 setButton 方式
        dialog.setButton(DialogInterface.BUTTON_POSITIVE, "确认 (" + 5 + ")", (d, w) -> {});
        dialog.setButton(DialogInterface.BUTTON_NEGATIVE, "取消", (d, w) -> d.dismiss());

        dialog.show();

        // 获取确认按钮
        Button positiveBtn = dialog.getButton(DialogInterface.BUTTON_POSITIVE);
        positiveBtn.setEnabled(false);
        positiveBtn.setTextColor(0xFFBBBBBB);

        final int[] seconds = {5};
        android.os.Handler handler = new android.os.Handler();
        Runnable countdown = new Runnable() {
            @Override
            public void run() {
                seconds[0]--;
                if (seconds[0] > 0) {
                    countdownText.setText(String.valueOf(seconds[0]));
                    positiveBtn.setText("确认 (" + seconds[0] + ")");
                    handler.postDelayed(this, 1000);
                } else {
                    // 倒计时结束
                    countdownText.setText("0");
                    positiveBtn.setText("确认删除");
                    positiveBtn.setEnabled(true);
                    positiveBtn.setTextColor(ContextCompat.getColor(MainActivity.this, R.color.primary));

                    // 重新设置点击事件
                    positiveBtn.setOnClickListener(v -> {
                        recordManager.clearAllRecords();
                        refreshUI();
                        dialog.dismiss();
                        Toast.makeText(MainActivity.this, "✅ 已清空所有记录", Toast.LENGTH_SHORT).show();
                    });
                }
            }
        };
        handler.postDelayed(countdown, 1000);
    }

    private String formatMoneyRaw(double value) {
        if (value == (long) value) {
            return String.format(Locale.CHINA, "¥ %d", (long) value);
        }
        return String.format(Locale.CHINA, "¥ %.2f", value);
    }

    /**
     * 将图表控件保存为 PNG 图片到相册
     * @param chartView 图表 View（PieChart / LineChart）
     * @param chartName 图表名称，用于文件名
     */
    private void saveChartToGallery(View chartView, String chartName) {
        try {
            // 1. 将 View 绘制为 Bitmap
            Bitmap bitmap = Bitmap.createBitmap(chartView.getWidth(), chartView.getHeight(), Bitmap.Config.ARGB_8888);
            Canvas canvas = new Canvas(bitmap);
            chartView.draw(canvas);

            // 2. 生成文件名
            SimpleDateFormat sdf = new SimpleDateFormat("yyyyMMdd_HHmmss", Locale.CHINA);
            String filename = chartName + "_" + sdf.format(new Date()) + ".png";

            // 3. 保存到相册
            String savedUrl = null;
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
                // Android 10+ 使用 MediaStore
                ContentValues values = new ContentValues();
                values.put(MediaStore.Images.Media.DISPLAY_NAME, filename);
                values.put(MediaStore.Images.Media.MIME_TYPE, "image/png");
                values.put(MediaStore.Images.Media.RELATIVE_PATH, Environment.DIRECTORY_PICTURES + "/记账助手");

                Uri uri = getContentResolver().insert(MediaStore.Images.Media.EXTERNAL_CONTENT_URI, values);
                if (uri != null) {
                    getContentResolver().openOutputStream(uri).write(bitmapToBytes(bitmap));
                    savedUrl = uri.toString();
                }
            } else {
                // Android 9 以下保存到公共目录
                String dir = Environment.getExternalStoragePublicDirectory(Environment.DIRECTORY_PICTURES) + "/记账助手";
                File file = new File(dir, filename);
                if (!file.getParentFile().exists()) file.getParentFile().mkdirs();
                FileOutputStream fos = new FileOutputStream(file);
                bitmap.compress(Bitmap.CompressFormat.PNG, 100, fos);
                fos.close();
                savedUrl = file.getAbsolutePath();

                // 通知图库刷新
                Intent intent = new Intent(Intent.ACTION_MEDIA_SCANNER_SCAN_FILE);
                intent.setData(Uri.fromFile(file));
                sendBroadcast(intent);
            }

            if (savedUrl != null) {
                Toast.makeText(this, chartName + " 已保存到相册 📸", Toast.LENGTH_SHORT).show();
            }
        } catch (Exception e) {
            Toast.makeText(this, "保存失败: " + e.getMessage(), Toast.LENGTH_SHORT).show();
        }
    }

    /** 将 Bitmap 转为字节数组 */
    private byte[] bitmapToBytes(Bitmap bitmap) {
        java.io.ByteArrayOutputStream baos = new java.io.ByteArrayOutputStream();
        bitmap.compress(Bitmap.CompressFormat.PNG, 100, baos);
        return baos.toByteArray();
    }

    private int dp(float dp) {
        float scale = getResources().getDisplayMetrics().density;
        return (int) (dp * scale + 0.5f);
    }
