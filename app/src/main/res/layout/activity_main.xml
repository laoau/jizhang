<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     xmlns:tools="http://schemas.android.com/tools"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@color/background"
     tools:context=".MainActivity">

    <FrameLayout
         android:layout_height="240dp"
         android:layout_width="match_parent"
         app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
         android:background="@drawable/bg_gradient_header">

    </FrameLayout>

    <androidx.core.widget.NestedScrollView
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:fillViewport="true"
         android:clipToPadding="false">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:orientation="vertical"
             android:paddingHorizontal="16dp">

            <Space
                 android:layout_height="20dp"
                 android:layout_width="match_parent" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="horizontal">

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:orientation="vertical"
                     android:layout_weight="1">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="18sp"
                         android:fontFamily="sans-serif-medium"
                         android:textColor="#FFFFFF"
                         android:text="👋 你好" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="13sp"
                         android:textColor="#DDFFFFFF"
                         android:layout_marginTop="2dp"
                         android:text="今天也要好好记账哦" />

                </LinearLayout>

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="14sp"
                     android:fontFamily="sans-serif-medium"
                     android:textColor="#FFFFFF"
                     android:id="@+id/tv_today"
                     android:text="2026-05-15"
                     android:layout_gravity="bottom" />

            </LinearLayout>

            <androidx.cardview.widget.CardView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 app:cardElevation="8dp"
                 app:cardBackgroundColor="@color/surface"
                 android:layout_marginTop="16dp"
                 app:cardCornerRadius="24dp"
                 android:id="@+id/card_summary">

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:padding="24dp"
                     android:orientation="vertical">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="13sp"
                         android:textColor="@color/text_secondary"
                         android:letterSpacing="0.03"
                         android:text="本月结余" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="32sp"
                         android:fontFamily="sans-serif-medium"
                         android:textColor="@color/text_primary"
                         android:layout_marginTop="6dp"
                         android:letterSpacing="0.02"
                         android:id="@+id/tv_balance"
                         android:text="¥ 0.00" />

                    <View
                         android:layout_height="1dp"
                         android:layout_width="match_parent"
                         android:layout_marginVertical="16dp"
                         android:background="@color/card_stroke" />

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:orientation="horizontal">

                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="0dp"
                             android:gravity="center_vertical"
                             android:orientation="horizontal"
                             android:layout_weight="1">

                            <View
                                 android:layout_height="10dp"
                                 android:layout_width="10dp"
                                 android:background="@drawable/circle_green" />

                            <LinearLayout
                                 android:layout_height="wrap_content"
                                 android:layout_width="0dp"
                                 android:orientation="vertical"
                                 android:layout_marginStart="10dp"
                                 android:layout_weight="1">

                                <TextView
                                     android:layout_height="wrap_content"
                                     android:layout_width="wrap_content"
                                     android:textSize="11sp"
                                     android:textColor="@color/text_hint"
                                     android:text="收入" />

                                <TextView
                                     android:layout_height="wrap_content"
                                     android:layout_width="wrap_content"
                                     android:textSize="17sp"
                                     android:fontFamily="sans-serif-medium"
                                     android:textColor="@color/income_green"
                                     android:layout_marginTop="2dp"
                                     android:id="@+id/tv_income"
                                     android:text="¥ 0.00" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="0dp"
                             android:gravity="center_vertical"
                             android:orientation="horizontal"
                             android:layout_weight="1">

                            <View
                                 android:layout_height="10dp"
                                 android:layout_width="10dp"
                                 android:background="@drawable/circle_red" />

                            <LinearLayout
                                 android:layout_height="wrap_content"
                                 android:layout_width="0dp"
                                 android:orientation="vertical"
                                 android:layout_marginStart="10dp"
                                 android:layout_weight="1">

                                <TextView
                                     android:layout_height="wrap_content"
                                     android:layout_width="wrap_content"
                                     android:textSize="11sp"
                                     android:textColor="@color/text_hint"
                                     android:text="支出" />

                                <TextView
                                     android:layout_height="wrap_content"
                                     android:layout_width="wrap_content"
                                     android:textSize="17sp"
                                     android:fontFamily="sans-serif-medium"
                                     android:textColor="@color/expense_red"
                                     android:layout_marginTop="2dp"
                                     android:id="@+id/tv_expense"
                                     android:text="¥ 0.00" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:weightSum="3"
                 android:orientation="horizontal"
                 android:layout_marginTop="24dp">

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:gravity="center"
                     android:orientation="vertical"
                     android:layout_weight="1"
                     android:id="@+id/btn_add_expense"
                     android:foreground="?attr/selectableItemBackgroundBorderless">

                    <com.google.android.material.card.MaterialCardView
                         android:layout_height="56dp"
                         android:layout_width="56dp"
                         app:cardElevation="2dp"
                         app:strokeWidth="0dp"
                         app:cardBackgroundColor="#FFF3E0"
                         app:cardCornerRadius="16dp"
                         android:foreground="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                             android:layout_height="match_parent"
                             android:layout_width="match_parent"
                             android:gravity="center"
                             android:src="@drawable/ic_expense"
                             android:scaleType="center" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="12sp"
                         android:textColor="#000000"
                         android:layout_marginTop="8dp"
                         android:text="支出" />

                </LinearLayout>

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:gravity="center"
                     android:orientation="vertical"
                     android:layout_weight="1"
                     android:id="@+id/btn_add_income"
                     android:foreground="?attr/selectableItemBackgroundBorderless">

                    <com.google.android.material.card.MaterialCardView
                         android:layout_height="56dp"
                         android:layout_width="56dp"
                         app:cardElevation="2dp"
                         app:strokeWidth="0dp"
                         app:cardBackgroundColor="#E8F5E9"
                         app:cardCornerRadius="16dp"
                         android:foreground="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                             android:layout_height="match_parent"
                             android:layout_width="match_parent"
                             android:gravity="center"
                             android:src="@drawable/ic_income"
                             android:scaleType="center" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="12sp"
                         android:textColor="#000000"
                         android:layout_marginTop="8dp"
                         android:text="收入" />

                </LinearLayout>

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:gravity="center"
                     android:orientation="vertical"
                     android:layout_weight="1"
                     android:id="@+id/btn_show_stats"
                     android:foreground="?attr/selectableItemBackgroundBorderless">

                    <com.google.android.material.card.MaterialCardView
                         android:layout_height="56dp"
                         android:layout_width="56dp"
                         app:cardElevation="2dp"
                         app:strokeWidth="0dp"
                         app:cardBackgroundColor="#E3F2FD"
                         app:cardCornerRadius="16dp"
                         android:foreground="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                             android:layout_height="match_parent"
                             android:layout_width="match_parent"
                             android:gravity="center"
                             android:src="@drawable/ic_stats"
                             android:scaleType="center" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="12sp"
                         android:textColor="#000000"
                         android:layout_marginTop="8dp"
                         android:text="统计" />

                </LinearLayout>

            </LinearLayout>

            <!-- 支出分类饼图 + 日/月切换 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- 标题栏 + 日/月切换按钮 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="支出分类"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.02" />

                        <!-- 切换按钮组 -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_toggle_group"
                            android:padding="2dp">

                            <TextView
                                android:id="@+id/btn_today_chart"
                                android:layout_width="42dp"
                                android:layout_height="28dp"
                                android:gravity="center"
                                android:text="日"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="#FFFFFF"
                                android:background="@drawable/bg_toggle_active"
                                android:paddingHorizontal="4dp" />

                            <TextView
                                android:id="@+id/btn_month_chart"
                                android:layout_width="42dp"
                                android:layout_height="28dp"
                                android:gravity="center"
                                android:text="月"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="#999999"
                                android:background="@android:color/transparent"
                                android:paddingHorizontal="4dp" />

                        </LinearLayout>

                    </LinearLayout>

                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/pieChart"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="horizontal"
                 android:layout_marginTop="24dp">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:textSize="16sp"
                     android:fontFamily="sans-serif-medium"
                     android:textColor="@color/text_primary"
                     android:layout_weight="1"
                     android:text="最近记录" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:paddingVertical="4dp"
                     android:textSize="12sp"
                     android:fontFamily="sans-serif-medium"
                     android:textColor="@color/primary"
                     android:paddingHorizontal="8dp"
                     android:id="@+id/btn_view_all"
                     android:text="查看全部 →"
                     android:foreground="?attr/selectableItemBackgroundBorderless" />

            </LinearLayout>

            <androidx.cardview.widget.CardView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_marginBottom="80dp"
                 app:cardElevation="3dp"
                 app:cardBackgroundColor="@color/surface"
                 android:layout_marginTop="10dp"
                 app:cardCornerRadius="20dp"
                 android:id="@+id/card_records">

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:orientation="vertical"
                     android:id="@+id/records_container">

                    <TextView
                         android:layout_height="60dp"
                         android:layout_width="match_parent"
                         android:gravity="center"
                         android:textSize="13sp"
                         android:textColor="@color/text_hint"
                         android:id="@+id/tv_empty"
                         android:text="暂无记录，点击上方按钮记账" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:src="@drawable/ic_add_white"
         android:contentDescription="添加记录"
         app:backgroundTint="@color/primary"
         android:layout_margin="20dp"
         app:elevation="8dp"
         app:fabSize="normal"
         app:borderWidth="0dp"
         android:id="@+id/fab_add"
         android:layout_gravity="bottom|end" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>